{
  "name": "oktayphp/notes-api",
  "description": "Notes API upgraded with Slim, JWT, and SQLite",
  "type": "project",
  "require": {
    "php": ">=8.0",
    "slim/slim": "^4.15",
    "nyholm/psr7": "^1.5",
    "slim/psr7": "^1.7",
    "vlucas/phpdotenv": "^5.5",
    "firebase/php-jwt": "^6.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "friendsofphp/php-cs-fixer": "^3.16"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "start": "php -S localhost:8002 -t public"
  }
}